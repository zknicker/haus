{
  "name": "@haus/website",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite",
    "build": "bun run check:browser-dependencies && vite build",
    "build:haus": "bun run check:browser-dependencies && HAUS_HOSTED_APP=1 vite build --outDir dist-haus",
    "check:browser-dependencies": "bun scripts/check-browser-dependency-graph.ts",
    "build:desktop:icons": "node ../../scripts/build-macos-app-icon.mjs",
    "icon:render-mesh": "bun scripts/render-icon-mesh.ts",
    "icon:render-favicon": "bun scripts/render-favicon.ts",
    "desktop:build": "bun run build:desktop:icons && bun x electron-builder --config electron-builder.config.cjs --mac",
    "desktop:build:unsigned": "bun run build:desktop:icons && node ../../scripts/release/build-desktop-unsigned.mjs",
    "desktop:build:app": "bun run build:desktop:icons && bun x electron-builder --config electron-builder.config.cjs --mac dir",
    "desktop:build:release": "bun run build:desktop:icons && node ../../scripts/release/build-desktop-release.mjs",
    "desktop:publish": "bun run desktop:build:release && node ../../scripts/release/check-desktop-artifacts.mjs && node ../../scripts/release/publish-desktop.mjs",
    "desktop:release": "bun run desktop:build:app && node ../../scripts/install-haus-app.mjs",
    "desktop:dev": "node ../../scripts/run-dev-stack.mjs desktop",
    "desktop:dev:launch": "node ../../scripts/run-desktop-dev.mjs",
    "start": "vite preview --strictPort --port 3100",
    "test": "bun test src electron",
    "lint": "ultracite check src e2e",
    "lint:fix": "ultracite fix src e2e",
    "test:app": "bun e2e/run-playwright.ts",
    "test:app:debug": "bun e2e/run-playwright.ts --debug",
    "test:app:headed": "bun e2e/run-playwright.ts --headed",
    "test:app:screenshot": "bun e2e/run-playwright.ts --screenshot on",
    "test:app:screenshot-failures": "bun e2e/run-playwright.ts --screenshot only-on-failure",
    "test:app:ui": "bun e2e/run-playwright.ts --ui",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/clerk-js": "^5.125.5",
    "@clerk/clerk-react": "^5.61.3",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@haus/api": "workspace:*",
    "@haus/sdk": "workspace:*",
    "@heroui-pro/react": "1.0.0-beta.9",
    "@heroui/react": "3.2.5",
    "@heroui/styles": "3.2.5",
    "@hugeicons-pro/core-duotone-rounded": "4.3.0",
    "@hugeicons-pro/core-solid-rounded": "4.3.0",
    "@hugeicons-pro/core-stroke-rounded": "4.3.0",
    "@hugeicons/core-free-icons": "4.0.0",
    "@hugeicons/react": "1.1.6",
    "@internationalized/date": "3.12.4",
    "@internationalized/number": "3.6.8",
    "@number-flow/react": "0.6.2",
    "@react-aria/interactions": "3.28.1",
    "@react-aria/utils": "3.34.1",
    "@react-stately/utils": "3.12.1",
    "@shadcn/react": "0.1.0",
    "@tailwindcss/vite": "4.2.1",
    "@tanstack/react-form": "1.29.0",
    "@tanstack/react-query": "5.90.21",
    "@tanstack/react-virtual": "3.14.10",
    "@trpc/client": "11.12.0",
    "@trpc/react-query": "11.12.0",
    "@trpc/server": "11.12.0",
    "@types/geojson": "7946.0.16",
    "clsx": "2.1.1",
    "d3-array": "3.2.4",
    "diff": "8.0.4",
    "electron-updater": "6.8.3",
    "embla-carousel": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "framer-motion": "12.40.0",
    "lucide-react": "1.21.0",
    "marked": "18.0.7",
    "motion": "12.40.0",
    "prosemirror-commands": "1.7.1",
    "prosemirror-history": "1.5.0",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.7",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.41.8",
    "react": "19.2.3",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.3",
    "react-hotkeys-hook": "5.2.4",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.12.2",
    "react-router-dom": "7.13.1",
    "react-stately": "3.50.0",
    "recharts": "3.10.1",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.3.1",
    "slot-text": "0.2.2",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/d3-array": "3.2.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "bun-types": "1.3.13",
    "electron": "42.3.0",
    "electron-builder": "26.8.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "ws": "8.21.0"
  },
  "trustedDependencies": [
    "heroui-pro",
    "@heroui-pro/react",
    "heroui-native-pro"
  ]
}
