{
    "name": "@haus/runner",
    "version": "17.0.0",
    "private": true,
    "bin": {
        "haus-runner": "src/index.ts"
    },
    "type": "module",
    "scripts": {
        "start": "bun src/index.ts",
        "test": "bun test --max-concurrency 1 --timeout 10000 src",
        "typecheck": "bunx tsc --noEmit"
    },
    "dependencies": {
        "@anthropic-ai/claude-agent-sdk": "0.3.326",
        "@earendil-works/chord": "1.5.2",
        "@earendil-works/pi-ai": "1.5.2",
        "@earendil-works/pi-durable": "1.5.2",
        "@earendil-works/pi-schema": "1.5.2",
        "@haus/agent-cli": "workspace:*",
        "@haus/agent-prompt": "workspace:*",
        "@haus/api": "workspace:*",
        "@haus/claude-usage": "workspace:*",
        "@haus/codex-usage": "workspace:*",
        "@haus/computer": "workspace:*",
        "@haus/mcp-executor": "workspace:*",
        "@napi-rs/canvas": "1.1.0",
        "pdfjs-dist": "6.4.299",
        "sh-syntax": "0.8.7",
        "turndown": "7.2.4",
        "unpdf": "2.1.0",
        "zod": "4.6.6"
    },
    "devDependencies": {
        "@types/bun": "1.3.13",
