{
  "name": "@haus/server",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun --watch src/haus-server.ts",
    "bootstrap:haus": "bun src/haus-server-bootstrap.ts",
    "build": "bun build src/haus-server.ts --target bun --format esm --outdir dist",
    "start": "bun dist/haus-server.js",
    "lint": "ultracite check src test",
    "lint:fix": "ultracite fix src test",
    "test": "drizzle-kit check --config=drizzle.postgres.config.ts && node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=drizzle.postgres.config.ts",
    "db:generate:postgres": "drizzle-kit generate --config=drizzle.postgres.config.ts",
    "db:check": "drizzle-kit check --config=drizzle.postgres.config.ts",
    "db:check:postgres": "drizzle-kit check --config=drizzle.postgres.config.ts",
    "db:migrate": "HAUS_MIGRATIONS_FOLDER=drizzle/postgres bun src/haus-server-migrate.ts",
    "db:migrate:postgres": "HAUS_MIGRATIONS_FOLDER=drizzle/postgres bun src/haus-server-migrate.ts"
  },
  "dependencies": {
    "@ai-sdk/mcp": "2.0.31",
    "@fastify/cors": "11.2.0",
    "@fastify/static": "10.1.3",
    "@haus/api": "workspace:*",
    "@haus/agent-manual": "workspace:*",
    "@haus/claude-usage": "workspace:*",
    "@haus/codex-usage": "workspace:*",
    "@haus/effect": "workspace:*",
    "@haus/sdk": "workspace:*",
    "@trpc/server": "11.12.0",
    "bottleneck": "2.19.5",
    "bunqueue": "2.6.38",
    "drizzle-orm": "0.45.2",
    "effect": "3.22.1",
    "fastify": "5.12.1",
    "jose": "6.2.3",
    "protobufjs": "7.6.6",
    "ws": "8.21.0",
    "yaml": "2.9.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@trpc/client": "11.12.0",
    "@types/ws": "8.18.1",
    "@types/node": "24.12.0",
    "bun-types": "1.3.13",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3"
  }
}
