// Varlock is the Server's only environment loader. A second one would silently
// outrank the committed contract.
language js

or { `import $_ from $source`, `import $source` } where {
  $filename <: r".*apps/server/src/config/.*",
  $source <: or { `'node:fs'`, `'fs'`, r"'dotenv.*'" },
  register_diagnostic(
    span = $source,
    message = "Server config never reads an env file of its own. Varlock is the only loader."
  )
}
