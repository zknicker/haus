// PRECONDITION_FAILED is the App's one "update required" signal: any procedure
// that throws it puts the whole App behind the update gate.
language js

`'PRECONDITION_FAILED'` as $code where {
  $filename <: r".*apps/server/src/.*",
  $filename <: not r".*apps/server/src/haus-api/trpc\.ts",
  $filename <: not r".*\.test\.ts",
  register_diagnostic(
    span = $code,
    message = "Only the App protocol gate in haus-api/trpc.ts throws PRECONDITION_FAILED, the App's update-required signal. Use another code."
  )
}
