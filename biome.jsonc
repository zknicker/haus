{
  "extends": ["ultracite/core", "ultracite/react"],
  // HeroUI compound-composition rules. Structural only — a className that
  // cancels a component's own spacing is not expressible in GritQL, so that
  // half lives in apps/website/src/lib/heroui-composition-contract.test.ts.
  "plugins": [
    "./apps/website/lint/heroui-compound-children.grit",
    "./apps/website/lint/heroui-dialog-form.grit"
  ],
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "!.claude/settings.local.json",
      "!.context",
      "!apps/ios-swift/**/*.xcassets",
      // Generated hugeicons geometry — one line of path data per family.
      "!apps/ios-swift/Sources/HausUI/Resources/*-icons.json",
      "!apps/server/dist",
      "!apps/server/drizzle/postgres/meta",
      "!apps/website/dist",
      "!apps/website/src-tauri/gen/schemas",
      "!apps/website/src/components/charts",
      "!assets/mac-icon.icon",
      "!**/*.css",
      "!**/*.grit"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 4,
    "lineWidth": 100,
    "lineEnding": "lf",
    "formatWithErrors": true,
    "attributePosition": "auto",
    "bracketSpacing": true
  },
  "javascript": {
    "globals": ["Bun"],
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "linter": {
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 20
          }
        },
        "noVoid": "off"
      },
      "a11y": {
        "noLabelWithoutControl": "off"
      },
      "correctness": {
        "noUnresolvedImports": "off"
      },
      "performance": {
        "noBarrelFile": "off",
        "noNamespaceImport": "off",
        "useTopLevelRegex": "off"
      },
      "style": {
        "noExportedImports": "off",
        "noNestedTernary": "off",
        "noNonNullAssertion": "off",
        "useConsistentMemberAccessibility": "off",
        "useDefaultSwitchClause": "off",
        "noParameterProperties": "off"
      },
      "suspicious": {
        "noBitwiseOperators": "off",
        "noControlCharactersInRegex": "off",
        "noEmptyBlockStatements": "off",
        "noMisplacedAssertion": "off",
        "useAwait": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/computer/src/agent-cli/agent-api-client.ts",
        "apps/computer/src/agent-cli/parse.ts",
        "apps/computer/src/host-skill-bundle.ts",
        "apps/computer/src/launch.ts",
        "apps/computer/src/usage/claude-local-usage.ts",
        "apps/computer/src/usage/grok-local-usage.ts",
        "apps/computer/src/usage/local-runtime-usage.ts",
        "apps/server/src/agent-api/action-routes.ts",
        "apps/server/src/agent-api/ask-routes.ts",
        "apps/server/src/automations/message-cause-read.ts",
        "apps/server/src/attachments/attachment-root.ts",
        "apps/server/src/computers/attachment-service.ts",
        "apps/server/src/chats/update-channel.ts",
        "apps/computer/src/harness/executor.test.ts",
        "apps/website/src/features/chats/thinking-steps.tsx",
        "apps/website/src/hooks/tasks/use-task-selection.ts",
        "scripts/agent-tests/kit.test.mjs",
        "scripts/release/release-impact.mjs"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 25
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/computer/src/login.ts",
        "apps/server/src/agent-api/routes.ts",
        "apps/server/src/agent-delivery/message-recipients.ts",
        "apps/server/src/reminders/reschedule.ts",
        "apps/server/src/reminders/scheduler.ts",
        "apps/server/src/tasks/assign-task.ts",
        "apps/website/src/components/quote/selection-quote.tsx",
        "apps/website/src/features/chats/chat-transcript-turn.tsx",
        "apps/website/src/features/chats/working-log.tsx",
        "apps/website/src/features/servers/chat/chat-topbar.tsx"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 30
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/server/test/controlled-oauth-mcp.ts",
        "apps/computer/src/proxy.ts",
        "apps/computer/src/usage/claude-plan-usage.ts",
        "apps/server/src/agent-api/tasks.ts",
        "apps/server/src/server-agents/configure-agent.ts",
        "apps/server/src/tasks/create-task.ts",
        "apps/website/src/features/chats/chat-transcript-model.ts",
        "apps/website/src/features/chats/chat-transcript-tool-intent-resolver.ts",
        "apps/website/src/features/servers/chat/chat-view.tsx",
        "apps/website/src/hooks/pane/use-pane-editor-host.ts",
        "scripts/agent-tests/turns.mjs"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 40
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/computer/src/attachment-daemon-loop.ts",
        "apps/server/src/computers/socket.ts",
        "apps/server/src/chats/send-agent-message.ts",
        "apps/server/src/chats/send-message.ts",
        "apps/website/src/features/usage/agents-usage-overview.tsx",
        "scripts/release/release-ledger.mjs"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 35
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/computer/src/harness/executor.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 90
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/server/src/agent-api/message-view.ts",
        "apps/server/src/agent-delivery/delivery.ts",
        "apps/server/src/avatar-generation/normalization.ts",
        "apps/website/src/hooks/use-proximity-hover.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 55
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/computer/src/index.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 110
              }
            }
          }
        }
      }
    }
  ]
}
