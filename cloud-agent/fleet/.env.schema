# Fleet-owned: copied from zknicker/agents templates/cloud-agent by
# bin/port-cloud-agent. Edit it there, not in a product repo.
#
# Resolves the zknicker/agents read key for cloud-agent/fetch-fleet.sh, apart
# from the repository's own environment contract in the root .env.schema.
# @plugin(@varlock/1password-plugin@2.0.3)
# @initOp(id=development, token=$CLOUD_AGENTS_DEVELOPMENT_OP_TOKEN, allowAppAuth=false, account=knickerbockerventures.1password.com)
# @defaultSensitive=true @defaultRequired=true
# ---

# The fleet-wide cloud-agent Development identity, provided by each cloud
# agent platform.
# @type=opServiceAccountToken @sensitive @internal
CLOUD_AGENTS_DEVELOPMENT_OP_TOKEN=

# Read access to zknicker/agents for the fleet bundle download.
# @sensitive @internal
FLEET_GITHUB_READ_TOKEN=op(development, "op://Development/GitHub Repo Read - Fleet Agents/credential")
