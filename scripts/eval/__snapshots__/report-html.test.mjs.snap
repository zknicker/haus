// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`renders every section of the report 1`] = `
"<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Placement Eval</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
:root{--bg:#f7f6f2; --fg:#1d1c1a; --muted:#6b6862; --line:#d9d6ce; --panel:#ffffff; --accent:#8a4b1f; --good:#2f7d4f; --bad:#b0372b; --warn:#a4731c; --soft:#efede7;
  --font:"IBM Plex Sans",system-ui,-apple-system,sans-serif;
  --mono:"IBM Plex Mono",ui-monospace,SFMono-Regular,Menlo,monospace}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#161614; --fg:#ebe8e1; --muted:#9a968d; --line:#33322e; --panel:#1f1e1b; --accent:#d08a52; --good:#6fc48f; --bad:#e77a6c; --warn:#d9a94a; --soft:#242320; color-scheme:dark;}}
:root[data-theme="dark"]{--bg:#161614; --fg:#ebe8e1; --muted:#9a968d; --line:#33322e; --panel:#1f1e1b; --accent:#d08a52; --good:#6fc48f; --bad:#e77a6c; --warn:#d9a94a; --soft:#242320; color-scheme:dark;}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font-family:var(--font);font-size:16px;line-height:1.55;padding-block:32px 64px;padding-inline:16px}
main{max-width:960px;margin:0 auto;display:grid;gap:44px}
h1{font-size:30px;font-weight:600;margin:0 0 6px;text-wrap:balance}
h2{font-size:22px;font-weight:600;margin:0 0 12px;text-wrap:balance}
h3{font-size:17px;font-weight:600;margin:0 0 8px}
h4{font-size:15px;font-weight:600;margin:0 0 6px}
p{max-width:66ch;margin:0 0 12px}
code{font-family:var(--mono);font-size:.9em;background:var(--soft);padding:1px 5px;border-radius:4px}
a{color:var(--accent)}
.eyebrow{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:6px}
.lede{color:var(--muted);font-size:17px}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
.kpi{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:14px 16px}
.kpi .n{font-size:30px;font-weight:600;font-variant-numeric:tabular-nums;line-height:1.1}
.kpi .l{font-size:13px;color:var(--muted);margin-top:6px}
.kpi.good .n{color:var(--good)} .kpi.bad .n{color:var(--bad)}
.bars{display:grid;gap:12px}
.bar-row{display:grid;grid-template-columns:260px 1fr;gap:14px;align-items:center}
.bar-row .lab{font-size:14px;overflow-wrap:anywhere}
.bar-row .lab small{display:block;color:var(--muted)}
.tracks{display:grid;gap:4px}
.track{display:grid;grid-template-columns:90px 1fr 64px;gap:8px;align-items:center;font-size:12px}
.track .who{color:var(--muted)}
.track .rail{height:10px;background:var(--soft);border-radius:3px;overflow:hidden}
.track .fill{height:100%;border-radius:3px}
.fill.base{background:var(--muted)} .fill.worse{background:var(--bad)} .fill.better{background:var(--good)}
.track .v{text-align:right;color:var(--muted);font-variant-numeric:tabular-nums}
.table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:8px;background:var(--panel)}
table{border-collapse:collapse;width:100%;font-size:14px}
th{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);font-weight:500;text-align:left;padding:10px 12px}
td{padding:9px 12px;border-top:1px solid var(--line);vertical-align:top}
td.num{font-variant-numeric:tabular-nums;white-space:nowrap}
td small{display:block;color:var(--muted)}
.causes{color:var(--muted);font-size:13px}
.chat{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:14px}
.pane{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:12px;min-width:0}
.pane .ph{display:flex;justify-content:space-between;align-items:baseline;gap:8px;margin-bottom:8px;font-size:12px;color:var(--muted)}
.pane .ph b{color:var(--fg);font-size:14px}
.msg{display:grid;grid-template-columns:52px 1fr;gap:8px;padding:7px 0;border-top:1px solid var(--line);font-size:14px}
.msg:first-of-type{border-top:0}
.msg .who{font-size:11px;color:var(--muted);padding-top:3px}
.msg .body{min-width:0;overflow-wrap:anywhere;white-space:pre-line}
.msg .body.thread{padding-left:12px;border-left:2px solid var(--line);color:var(--muted)}
.tag{display:inline-block;font-size:11px;padding:1px 7px;border-radius:999px;margin-left:6px;vertical-align:middle;border:1px solid var(--line);color:var(--muted);white-space:nowrap}
.tag.ok{border-color:var(--good);color:var(--good)} .tag.bad{border-color:var(--bad);color:var(--bad)} .tag.warn{border-color:var(--warn);color:var(--warn)}
.verdict{font-size:13px;margin-top:8px;padding-top:8px;border-top:1px dashed var(--line)}
.verdict.ok{color:var(--good)} .verdict.bad{color:var(--bad)} .verdict.warn{color:var(--warn)}
.empty{color:var(--muted);font-size:14px}
.note{background:var(--soft);border-left:3px solid var(--accent);padding:12px 16px;border-radius:0 6px 6px 0;max-width:70ch}
.notes ol,.notes ul{max-width:70ch;padding-left:20px} .notes li{margin:6px 0}
ul.caveats{max-width:70ch;padding-left:20px;margin:0} ul.caveats li{margin:6px 0}
@media (max-width:640px){.bar-row{grid-template-columns:1fr} .track{grid-template-columns:70px 1fr 56px}}
</style>
</head>
<body>
<main>
<header>
  <div class="eyebrow">Haus · placement eval · October 15, 2026</div>
  <h1>Placement: the change is 100 points better</h1>
  <p class="lede">Answers land where the asker looks.</p>
  <p class="lede">Baseline: 0123456789 · Change: working tree @ abc · 1 pass × 1 scenarios · model codex/terra</p>
</header>

<section class="notes">
<h2>What was changed</h2>
<ol><li><strong>Rewrote</strong> the <code>send</code> hint.</li></ol>
</section>

<section>
<h2>Results</h2>
<div class="kpis">
<div class="kpi"><div class="n">0 of 1</div><div class="l">Baseline (0123456789), 0%.</div></div>
<div class="kpi good"><div class="n">1 of 1</div><div class="l">Change (working tree @ abc), 100%.</div></div>
<div class="kpi good"><div class="n">+100 pts</div><div class="l">Change pass rate minus baseline.</div></div>
</div>
<h3 style="margin-top:20px">Pass rate by scenario</h3>
<div class="bars">
<div class="bar-row"><div class="lab">placement-quick-fact<small>S2</small></div><div class="tracks">
<div class="track"><span class="who">baseline</span><div class="rail"><div class="fill base" style="width:0%"></div></div><span class="v">0/1</span></div>
<div class="track"><span class="who">change</span><div class="rail"><div class="fill better" style="width:100%"></div></div><span class="v">1/1</span></div></div></div>
</div>
<p style="margin-top:12px;font-size:14px;color:var(--muted)">Pass is the live runner's structural verdict. Infra failures (⚠) are counted in caveats and left out of the rate.</p>
</section>

<section>
<h2>Grader detail</h2>
<p>Spec is the out-of-band grader: every structural check plus word cap, tails, and questions. Words is the mean length of the graded result post; tails counts offer phrases across runs; judge is the mean Jev score (1-5, pass bar 4).</p>
<div class="table-wrap"><table>
<thead><tr><th>Scenario</th><th>Build</th><th>Runner</th><th>Spec</th><th>Words</th><th>Tails</th><th>Judge</th><th>Failure causes</th></tr></thead>
<tbody>
<tr><td rowspan="2">placement-quick-fact<small>S2</small></td><td>Baseline</td><td class="num">0/1</td><td class="num">0/1</td><td class="num">7</td><td class="num">1</td><td class="num">-</td><td class="causes">no tail phrase; result is an inline reply; result post placement</td></tr>
<tr><td>Change</td><td class="num">1/1</td><td class="num">1/1</td><td class="num">1</td><td class="num">0</td><td class="num">-</td><td class="causes">-</td></tr>
</tbody>
</table></div>
</section>

<section>
<h2>What the agent posted</h2>
<p>One representative run per build: the first whose runner verdict matches that build's majority. Grey indented lines are inside a Thread; badges say where each post landed.</p>
<h3 style="margin-top:22px">placement-quick-fact</h3>
<div class="chat">
<div class="pane"><div class="ph"><b>Baseline</b><span>fail · pass 1 · 20261015T100500</span></div>
<div class="msg"><span class="who">Human</span><div class="body">fyi dev server port is 43447 this week</div></div>
<div class="msg"><span class="who">Human</span><div class="body">what port is the dev server on again?</div></div>
<div class="msg"><span class="who">Agent</span><div class="body">43447 &lt;b&gt;. Want me to restart it?<span class="tag bad">channel, not a reply</span><span class="tag ok">marked finished</span></div></div>
<div class="verdict bad">runner: result post placement · no tail phrase · result is an inline reply</div></div>
<div class="pane"><div class="ph"><b>Change</b><span>pass · pass 1 · 20261015T100000</span></div>
<div class="msg"><span class="who">Human</span><div class="body">fyi dev server port is 43447 this week</div></div>
<div class="msg"><span class="who">Human</span><div class="body">what port is the dev server on again?</div></div>
<div class="msg"><span class="who">Agent</span><div class="body">43447.<span class="tag ok">reply in channel</span><span class="tag ok">marked finished</span></div></div>
</div>
</div>
</section>

<section>
<h2>Caveats</h2>
<ul class="caveats">
<li>n = 1 pass(es) per build × 1 scenario(s). Agents are not deterministic; small n is weak evidence.</li>
<li>Judge: skipped (no HAUS_TYPESAFE_API_KEY).</li>
<li>Baseline infra: pass 2: the runner exited 1 without a run report</li>
<li>Change stack left behind: mounted /Users/x/.haus/dev/eval-placement-change/w</li>
</ul>
</section>
</main>
</body>
</html>
"
`;
