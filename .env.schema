# Haus environment contract.
#
# This file is the single declaration of every value Haus reads from its
# environment: canonical name, sensitivity, type, and the exact 1Password
# reference each lifecycle resolves. Values live in 1Password; this file never
# contains one. There is no `.env` step anywhere — local development, Cursor
# cloud agents, GitHub Actions, and the Mac mini all resolve through this
# schema.
#
# The plugin version is pinned so the schema resolves through `bunx varlock`
# before node_modules exists (cloud-agent installs, the mini's deploy job).
# @plugin(@varlock/1password-plugin@2.0.3)
# @initOp(id=development, token=fallback($CURSOR_CLOUD_AGENTS_DEVELOPMENT_OP_TOKEN, $CI_OP_TOKEN), allowAppAuth=forEnv(development), account=knickerbockerventures.1password.com)
# @initOp(id=production, token=$DEPLOY_AGENT_PRODUCTION_OP_TOKEN, allowAppAuth=false)
# @initOp(id=tooling, token=$RELEASE_AGENT_TOOLING_OP_TOKEN, allowAppAuth=forEnv(development), account=knickerbockerventures.1password.com)
# @currentEnv=$VARLOCK_ENV
# Lifecycles: production and development resolve through 1Password; test
# resolves to fake-but-shaped literals only, so schema validation and every
# test lane run fully offline with no 1Password access. Every lifecycle
# resolves deliberately — add a test arm whenever you add a variable.
# Sensitivity fails safe: an item without an explicit marker resolves as
# sensitive, so a forgotten decorator becomes a masked value rather than a
# plaintext string inlined into the App bundle. Public values opt out
# explicitly.
# @defaultSensitive=true @defaultRequired=infer
# ---

# Varlock's selector. The enum is the fail-loud guard: any other value —
# including lifecycles varlock can infer in CI, like preview — is rejected at
# load instead of silently riding each value's development arm.
# @public @auditIgnore @type=enum(development, production, test)
VARLOCK_ENV=development

# Bun-owned startup flag: 1.3.5 can misroute cached/uncached SQL replies and
# hang requests. Preserve prepared parameter encoding while disabling the
# faulty pipeline. Remove after adopting https://github.com/oven-sh/bun/pull/33627.
# @public @auditIgnore @type=enum(1)
BUN_FEATURE_FLAG_DISABLE_SQL_AUTO_PIPELINING=1


# --- Bootstrap identities ------------------------------------------------
# One per unattended consumer; the name encodes the consumer and lifecycle it
# serves. Supervised local work uses 1Password desktop-app authorization
# instead. All are @internal, so `varlock run` never exports them into the
# Server process or into a rendered config file.

# Production deploy-agent role slot: each deploy venue supplies its own
# identity under this one name. The self-hosted GitHub Actions runner on the
# Mac mini injects the GitHub deploy agent's read-only token (repository secret
# GH_DEPLOY_AGENT_PRODUCTION_OP_TOKEN).
# @type=opServiceAccountToken @sensitive @internal @auditIgnore
# @required=forEnv(production)
DEPLOY_AGENT_PRODUCTION_OP_TOKEN=

# Shared Cursor cloud-agent development identity, read-only on the Development
# vault, injected by Cursor as an account-scoped Runtime Secret. Supervised
# local development leaves this empty and uses desktop-app authorization.
# @type=opServiceAccountToken @sensitive @internal @auditIgnore
# @optional
CURSOR_CLOUD_AGENTS_DEVELOPMENT_OP_TOKEN=

# CI bootstrap role slot. Quality supplies the fleet deploy identity here;
# the schema selects Development for licensed dependency installation.
# Cursor credentials never cross into GitHub Actions.
# @type=opServiceAccountToken @sensitive @internal @auditIgnore
# @optional
CI_OP_TOKEN=

# GitHub Release workflow identity, read-only on the Tooling vault. Local
# releases leave this empty and authorize the same references through the
# 1Password desktop app.
# @type=opServiceAccountToken @sensitive @internal @auditIgnore
# @optional
RELEASE_AGENT_TOOLING_OP_TOKEN=


# --- Context switches ----------------------------------------------------
# Machinery credentials resolve ONLY behind these switches, so the Vite build,
# the dev stack, the Server, and every test lane never contact 1Password. Only
# switches with a real consumer are declared. Server traffic uses a named
# Tunnel credential on its host; the separate public release Worker resolves
# Cloudflare deployment credentials only under its own switch.

# Set to true by the install paths (`.cursor/install.sh`, the Quality
# workflow) when fetching install tokens with `varlock printenv`.
# @public @internal @auditIgnore @type=boolean
HAUS_RESOLVE_INSTALL_TOKENS=false

# Set to true by the operator release commands (`release:publish`,
# `computer:release`, `publish:desktop`) so Apple, S3, and Computer signing
# credentials resolve. Off by default, which is what lets `env:load` and
# `check` succeed on a Cursor cloud agent that can reach none of them.
# @public @internal @auditIgnore @type=boolean
HAUS_RESOLVE_RELEASE_TOKENS=false

# Set only while deploying Haus public Cloudflare Workers. The credential authenticates
# Wrangler and is never delivered to the Worker.
# @public @internal @auditIgnore @type=boolean
HAUS_RESOLVE_RELEASE_HOST_TOKEN=false

# Shared Cloudflare Worker deployment credential. Wrangler reads it only from
# the deploy process environment; it is never a Worker binding.
# @sensitive @internal @auditIgnore @optional
CLOUDFLARE_API_TOKEN=if(eq($HAUS_RESOLVE_RELEASE_HOST_TOKEN, true), op(production, "op://Production/Cloudflare Deploy - Merchbase/credential"), "")


# --- Install-time machinery ----------------------------------------------
# Both are licensed registry credentials shared across the whole suite, so the
# name identifies the issuing owner rather than this repo and each resolves
# from the existing shared item — no per-repo copy is created.

# Licensed @hugeicons-pro dist downloads for the App icon set. Referenced
# literally by bunfig.toml's `[install.scopes]` token.
# @sensitive @internal @auditIgnore @optional
MERCHBASE_HUGEICONS_LICENSE_KEY=if(eq($HAUS_RESOLVE_INSTALL_TOKENS, true), op(development, "op://Development/HugeIcons Pro - Merchbase/credential"), "")

# Licensed HeroUI Pro dist downloads. `scripts/setup-worktree.mjs` bridges this
# canonical name onto the vendor installer's literal HEROUI_AUTH_TOKEN.
# @sensitive @internal @auditIgnore @optional
HEROUI_PRO_CICD_TOKEN=if(eq($HAUS_RESOLVE_INSTALL_TOKENS, true), op(development, "op://Development/HeroUI Pro CICD - Merchbase/credential"), "")


# --- Clerk (Haus's own tenancy) ----------------------------------------
# Haus has its own Clerk application, separate from the Merchbase suite
# instance: development is worthy-peacock-11.clerk.accounts.dev and production
# is clerk.haus.chat. Both credentials are therefore project-owned.

# The Clerk instance origin whose JWKS signs human session tokens. Naming the
# development instance explicitly is deliberate: pointing a development arm at
# the production issuer makes every locally minted token fail the issuer check.
# @public @type=url
HAUS_CLERK_ISSUER_URL=ifs(eq($VARLOCK_ENV, production), https://clerk.haus.chat, eq($VARLOCK_ENV, test), https://clerk-test.haus.invalid, https://worthy-peacock-11.clerk.accounts.dev)

# Clerk Backend API origin. Only ever set for a non-production Clerk instance;
# nothing provisions it today and the Server falls back to Clerk's default.
# @public @optional
HAUS_CLERK_API_URL=

# Backend key. The hosted Server needs it to confirm which of a human's email
# addresses Clerk has verified, and the dev auto sign-in flow mints tokens with
# it. A release build does neither, so it leaves this undefined rather than
# widening the Tooling-only release identity into the Development vault.
# @sensitive @required=forEnv(production)
HAUS_CLERK_SECRET_KEY=ifs(eq($HAUS_RESOLVE_RELEASE_TOKENS, true), undefined, eq($VARLOCK_ENV, test), sk_test_haus_fixture_key, eq($VARLOCK_ENV, production), op(production, "op://Production/Clerk - Haus/credential"), op(development, "op://Development/Clerk - Haus/credential"))

# Clerk user the localhost-only automatic dev sign-in flow signs in as.
# Development only: production never auto-signs anyone in.
# @sensitive @optional
HAUS_DEV_CLERK_SIGN_IN_USER_ID=ifs(eq($HAUS_RESOLVE_RELEASE_TOKENS, true), undefined, eq($VARLOCK_ENV, test), user_haus_test_fixture, eq($VARLOCK_ENV, production), undefined, op(development, "op://Development/Dev Sign-In User - Haus/username"))


# --- Hosted Haus Server runtime ----------------------------------------
# Production values are literals for host paths and ports the operator fixed at
# cutover, and 1Password references for anything secret. Development and test
# resolve to `undefined` wherever the dev stack derives the value per worktree
# — `undefined`, never "", because the Server's zod schema treats an empty
# string as present and would reject it instead of applying its default.

# Haus App origin the Server advertises. Development derives it from the
# per-worktree website port.
# @public @optional @type=url
HAUS_APP_ORIGIN=if(eq($VARLOCK_ENV, production), https://haus.chat, undefined)

# Loopback port the Server binds. The Cloudflare Tunnel sends haus.chat here.
# Development derives a per-worktree port.
# @public @optional @type=port
HAUS_SERVER_PORT=if(eq($VARLOCK_ENV, production), 18791, undefined)

# Attachment tree root. Owned by _haus_server on the mini; the dev stack puts
# it under the per-worktree state directory.
# @public @optional
HAUS_ATTACHMENT_ROOT=if(eq($VARLOCK_ENV, production), /Users/zknicker/srv/haus/data/attachments, undefined)

# Built Haus App the Server serves from its own origin. Production only: in
# development Vite serves the App.
# @public @optional
HAUS_STATIC_APP_ROOT=if(eq($VARLOCK_ENV, production), /Users/zknicker/srv/haus/current/share/haus-server/app, undefined)

# Release identity manifest of the activated release. Its presence is what
# makes the Server treat itself as a production release, so it is production
# only.
# @public @optional
HAUS_RELEASE_MANIFEST=if(eq($VARLOCK_ENV, production), /Users/zknicker/srv/haus/current/release.json, undefined)

# Signed Haus Computer update descriptor the Server hands to attached
# Computers.
# @public @optional @type=url
HAUS_COMPUTER_RELEASE_MANIFEST_URL=if(eq($VARLOCK_ENV, production), https://releases.haus.chat/computer/latest.json, undefined)

# Server-owned OpenAI credential for the transient avatar generator. Development
# and production use independently rotated lifecycle credentials; deterministic
# test fixtures stay offline. Release tooling never resolves this runtime credential.
# @sensitive @required=forEnv(production)
HAUS_OPENAI_API_KEY=ifs(eq($HAUS_RESOLVE_RELEASE_TOKENS, true), undefined, eq($VARLOCK_ENV, test), sk_test_haus_avatar_fixture, eq($VARLOCK_ENV, production), op(production, "op://Production/OpenAI API - Haus/credential"), op(development, "op://Development/OpenAI API - Haus/credential"))

# Local-only deterministic image provider for the opt-in Agent E2E recipe scenario.
# It is honored only by a development stack and records request counts at the
# operator-selected path; never set it in a released Server environment.
# @public @optional
HAUS_AGENT_E2E_AVATAR_FIXTURE=undefined

# Absolute path to the checked-in PNG used by the local fixture.
# @public @optional
HAUS_AGENT_E2E_AVATAR_FIXTURE_PATH=undefined

# Optional absolute JSONL report path paired with the local avatar fixture.
# @public @optional
HAUS_AGENT_E2E_AVATAR_REQUEST_LOG=undefined

# Opt-in switch for the one live Cursor Cloud Agent smoke on a Computer whose
# Cursor credential is already connected. It spends a real Cursor allowance, so
# every automated lane leaves it unset and runs against recorded responses.
# Set it to 1 by hand when verifying the adapter against Cursor itself.
# @public @optional
HAUS_RUN_LIVE_CURSOR_TEST=undefined

# The `owner/name` repository the live Cursor smoke delegates to. The operator
# picks it per run; Haus keeps no repository registry.
# @public @optional
HAUS_LIVE_CURSOR_REPOSITORY=undefined


# --- OpenTelemetry -------------------------------------------------------
# Server and Computer telemetry is opt-in. With no endpoint the Effect runtime
# installs no exporters and performs no telemetry network I/O. A shared OTLP
# HTTP endpoint may be overridden per signal. Header values are sensitive
# because hosted collectors commonly use them for authorization.

# @public @optional @type=url
OTEL_EXPORTER_OTLP_ENDPOINT=undefined

# @public @optional @type=url
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=ifs(eq($HAUS_RESOLVE_RELEASE_TOKENS, true), undefined, eq($VARLOCK_ENV, test), undefined, https://us-east-1.aws.edge.axiom.co/v1/traces)

# @public @optional @type=url
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=ifs(eq($HAUS_RESOLVE_RELEASE_TOKENS, true), undefined, eq($VARLOCK_ENV, test), undefined, https://us-east-1.aws.edge.axiom.co/v1/metrics)

# @sensitive @optional
OTEL_EXPORTER_OTLP_HEADERS=

# Axiom stores operations and metrics separately while the standard deployment
# resource attribute distinguishes development from production. Each lifecycle
# uses an independently rotated 1Password credential. Release jobs have only
# Tooling access and neither resolve runtime credentials nor export telemetry.
# @sensitive @optional
OTEL_EXPORTER_OTLP_TRACES_HEADERS=ifs(eq($HAUS_RESOLVE_RELEASE_TOKENS, true), undefined, eq($VARLOCK_ENV, test), undefined, eq($VARLOCK_ENV, production), concat("Authorization=Bearer ", op(production, "op://Production/Axiom Production OTLP - Haus/credential"), ",X-Axiom-Dataset=haus-operations"), concat("Authorization=Bearer ", op(development, "op://Development/Axiom Development OTLP - Haus/credential"), ",X-Axiom-Dataset=haus-operations"))

# @sensitive @optional
OTEL_EXPORTER_OTLP_METRICS_HEADERS=ifs(eq($HAUS_RESOLVE_RELEASE_TOKENS, true), undefined, eq($VARLOCK_ENV, test), undefined, eq($VARLOCK_ENV, production), concat("Authorization=Bearer ", op(production, "op://Production/Axiom Production OTLP - Haus/credential"), ",X-Axiom-Metrics-Dataset=haus-metrics"), concat("Authorization=Bearer ", op(development, "op://Development/Axiom Development OTLP - Haus/credential"), ",X-Axiom-Metrics-Dataset=haus-metrics"))

# @public @optional
OTEL_RESOURCE_ATTRIBUTES=concat("deployment.environment.name=", $VARLOCK_ENV)

# Emergency off switch even when an endpoint is configured.
# @public @type=boolean
OTEL_SDK_DISABLED=false


# --- PostgreSQL ----------------------------------------------------------
# One cluster on the mini, three least-privilege roles, one 1Password item.
# Development runs a throwaway per-worktree cluster with no password at all, so
# every arm below is production-only.

# Runtime login: CONNECT, schema USAGE, and table DML only. Read by the Server.
# Required in production: the Server's typed env carries a local-development
# default, so a missing value would boot it against the wrong database instead
# of failing.
# @sensitive @required=forEnv(production)
HAUS_DATABASE_URL=ifs(eq($VARLOCK_ENV, test), postgres://haus_runtime:haus@127.0.0.1:5438/haus_test, eq($VARLOCK_ENV, production), op(production, "op://Production/Postgres - Haus/runtime url"), undefined)

# Migration login (haus_bootstrap): owns the database and its public schema.
# Read ONLY by the deploy job's migration step, never by the running Server.
# @sensitive @required=forEnv(production)
HAUS_DATABASE_MIGRATION_URL=ifs(eq($VARLOCK_ENV, test), postgres://haus_bootstrap:haus@127.0.0.1:5438/haus_test, eq($VARLOCK_ENV, production), op(production, "op://Production/Postgres - Haus/migration url"), undefined)

# Container superuser password for the pinned PostgreSQL image. Interpolated by
# apps/server/compose.yml when the deploy job brings the database up under
# `varlock run`.
# @sensitive @required=forEnv(production)
HAUS_POSTGRES_ADMIN_PASSWORD=ifs(eq($VARLOCK_ENV, test), haus-test-admin-password, eq($VARLOCK_ENV, production), op(production, "op://Production/Postgres - Haus/admin password"), undefined)

# Least-privilege role names the bootstrap and migration programs grant to.
# Public: they are role names, not credentials.
# @public
HAUS_DATABASE_RUNTIME_ROLE=haus_runtime

# The read-only role every migration re-grants. The scheduled off-machine
# backup that used it has been retired; the role and its grants stay so the
# migration program's privilege model is unchanged.
# @public
HAUS_DATABASE_BACKUP_ROLE=haus_backup

# One-time fresh-cluster bootstrap login. Nothing provisions it: the operator
# supplies it by hand for the single bootstrap run on a brand-new database.
# @sensitive @optional
HAUS_DATABASE_BOOTSTRAP_URL=


# --- Google Calendar MCP connection --------------------------------------
# OAuth client the Server presents when an operator connects Google Calendar as
# a remote MCP server. Only a development client exists today; the hosted
# Server resolves `undefined` and reports the connection as unavailable until a
# production client is registered.

# @sensitive @optional
HAUS_GOOGLE_OAUTH_CLIENT_ID=ifs(eq($HAUS_RESOLVE_RELEASE_TOKENS, true), undefined, eq($VARLOCK_ENV, test), haus-test.apps.googleusercontent.com, eq($VARLOCK_ENV, production), undefined, op(development, "op://Development/Google MCP OAuth - Haus/username"))

# @sensitive @optional
HAUS_GOOGLE_OAUTH_CLIENT_SECRET=ifs(eq($HAUS_RESOLVE_RELEASE_TOKENS, true), undefined, eq($VARLOCK_ENV, test), haus-test-google-oauth-secret, eq($VARLOCK_ENV, production), undefined, op(development, "op://Development/Google MCP OAuth - Haus/credential"))


# --- Haus App build inputs ---------------------------------------------
# External literal-prefix exemption: Vite only exposes variables whose name
# begins with VITE_, so the prefix is a platform requirement rather than a
# naming choice. Everything here is inlined into a public browser bundle at
# build time and must therefore be @public — a @sensitive value in this block
# would ship to every visitor.

# Clerk publishable keys are public by design, but they stay in the contract so
# the App and the Server cannot drift onto different Clerk instances. The
# production key is the same literal the iOS client compiles in.
#
# The release switch is checked FIRST, ahead of the lifecycle, and that ordering
# is the whole point. A release is published from an operator's machine, which
# necessarily resolves the development lifecycle: the production 1Password
# instance sets `allowAppAuth=false` and the development one allows desktop
# authorization only `forEnv(development)`, so no release can run under
# VARLOCK_ENV=production. Selecting this key by lifecycle alone therefore inlined
# the development instance's key into the Server artifact users actually run.
# `HAUS_RESOLVE_RELEASE_TOKENS=true` means exactly "this run produces a
# shippable artifact", which is the real question this value depends on.
# @public
VITE_CLERK_PUBLISHABLE_KEY=ifs(eq($HAUS_RESOLVE_RELEASE_TOKENS, true), pk_live_Y2xlcmsuaGF1cy5jaGF0JA, eq($VARLOCK_ENV, production), pk_live_Y2xlcmsuaGF1cy5jaGF0JA, eq($VARLOCK_ENV, test), pk_test_Y2xlcmstdGVzdC5oYXVzLmludmFsaWQk, pk_test_d29ydGh5LXBlYWNvY2stMTEuY2xlcmsuYWNjb3VudHMuZGV2JA)

# Localhost-only automatic sign-in in the App. Development only, never a
# shippable artifact even though release commands use the development lifecycle.
# @public @optional @type=boolean
VITE_DEV_CLERK_AUTO_SIGN_IN=ifs(eq($HAUS_RESOLVE_RELEASE_TOKENS, true), undefined, eq($VARLOCK_ENV, development), true, undefined)

# Browser-reachable App origin embedded in manually delivered invitation links.
# Required for packaged desktop builds, whose file: origin cannot be shared.
# Operator-supplied at build time; nothing provisions it per lifecycle.
# @public @optional @type=url
VITE_HAUS_APP_ORIGIN=


# --- Release credentials -------------------------------------------------
# Release material lives in the Tooling vault. Local operators authorize these
# references through the 1Password desktop app; the GitHub Release workflow uses
# its dedicated read-only Tooling identity. All values remain gated on the
# release switch, so cloud agents, Quality, and the dev stack never evaluate them.
#
# Two credentials are shared, not project-owned. Haus's notarization identity
# and its release-bucket IAM key were byte-for-byte the same values the
# Merchbase desktop app already stores, so this repo adopts those items rather
# than minting duplicates. The env names stay literal: electron-builder,
# notarytool, and the aws CLI each read them under their own name.

# Apple ID and app-specific password for notarizing the Haus desktop app and
# the Haus Computer executable. Shared suite identity.
# @sensitive @internal @auditIgnore @optional
APPLE_ID=if(eq($HAUS_RESOLVE_RELEASE_TOKENS, true), op(tooling, "op://Tooling/Apple Notarization - Merchbase/username"), "")

# @sensitive @internal @auditIgnore @optional
APPLE_APP_SPECIFIC_PASSWORD=if(eq($HAUS_RESOLVE_RELEASE_TOKENS, true), op(tooling, "op://Tooling/Apple Notarization - Merchbase/credential"), "")

# PKCS#12 bundle containing the Apple Development, Apple Distribution, and
# Developer ID Application identities used by ephemeral GitHub-hosted keychains.
# @sensitive @internal @auditIgnore @optional
HAUS_RELEASE_APPLE_CERTIFICATES_P12_BASE64=if(eq($HAUS_RESOLVE_RELEASE_TOKENS, true), op(tooling, "op://Tooling/Apple Signing - Haus/certificates p12 base64"), "")

# @sensitive @internal @auditIgnore @optional
HAUS_RELEASE_APPLE_CERTIFICATES_PASSWORD=if(eq($HAUS_RESOLVE_RELEASE_TOKENS, true), op(tooling, "op://Tooling/Apple Signing - Haus/password"), "")

# App Store Connect private key. The workflow writes it only to RUNNER_TEMP and
# supplies the resulting path to xcodebuild.
# @sensitive @internal @auditIgnore @optional
HAUS_RELEASE_APP_STORE_CONNECT_PRIVATE_KEY=if(eq($HAUS_RESOLVE_RELEASE_TOKENS, true), op(tooling, "op://Tooling/App Store Connect - Haus/private key"), "")

# @sensitive @internal @auditIgnore @optional
APPLE_API_KEY_ID=if(eq($HAUS_RESOLVE_RELEASE_TOKENS, true), op(tooling, "op://Tooling/App Store Connect - Haus/key id"), "")

# @sensitive @internal @auditIgnore @optional
APPLE_API_ISSUER=if(eq($HAUS_RESOLVE_RELEASE_TOKENS, true), op(tooling, "op://Tooling/App Store Connect - Haus/issuer id"), "")

# @public @optional
APPLE_API_KEY_PATH=

# Apple Developer team id. Public: it appears in every signed binary and in the
# generated Computer installer script.
# @public
APPLE_TEAM_ID=XJ8RZZT99R

# Developer ID Application identity. The certificate and its private key stay
# in the operator's login Keychain — only the identity's name travels, and it
# is public.
# @public
APPLE_SIGNING_IDENTITY=Developer ID Application: Zachary Adam Knickerbocker (XJ8RZZT99R)

# Destination bucket for published desktop and Computer artifacts. The URI is
# public; the IAM credentials that write it are the shared Merchbase desktop
# release key, adopted rather than duplicated.
# @public
HAUS_RELEASE_S3_URI=s3://punchpress-electron-app-209596837609-us-east-1-an/haus/mac

# @sensitive @internal @auditIgnore @optional
AWS_ACCESS_KEY_ID=if(eq($HAUS_RESOLVE_RELEASE_TOKENS, true), op(tooling, "op://Tooling/S3 Release - Merchbase Desktop/username"), "")

# @sensitive @internal @auditIgnore @optional
AWS_SECRET_ACCESS_KEY=if(eq($HAUS_RESOLVE_RELEASE_TOKENS, true), op(tooling, "op://Tooling/S3 Release - Merchbase Desktop/credential"), "")

# Public base URL the electron-updater feed reads.
# @public @type=url
HAUS_RELEASE_BASE_URL=https://punchpress-electron-app-209596837609-us-east-1-an.s3.us-east-1.amazonaws.com/haus/mac

# Public base URL every installed Haus Computer polls for updates.
# @public @type=url
HAUS_COMPUTER_RELEASE_BASE_URL=https://releases.haus.chat/computer

# Ed25519 keypair that signs the Haus Computer release descriptor. The
# private half is the strongest credential in this schema: anything holding it
# can publish an update every installed Computer will accept.
# @sensitive @internal @auditIgnore @optional
HAUS_COMPUTER_RELEASE_PRIVATE_KEY=if(eq($HAUS_RESOLVE_RELEASE_TOKENS, true), op(tooling, "op://Tooling/Computer Release Signing - Haus/private key"), "")

# Public half. Compiled into every Computer build as its update trust anchor.
# @public @optional
HAUS_COMPUTER_RELEASE_PUBLIC_KEY=if(eq($HAUS_RESOLVE_RELEASE_TOKENS, true), op(tooling, "op://Tooling/Computer Release Signing - Haus/public key"), "")
