# Claude Code preview launch config — generated per checkout by scripts/generate-claude-launch.mjs
.claude/launch.json

# Claude-managed worktrees. Nested checkouts, never part of this checkout's tree;
# committing them leaves stale worktree configs that break lint runs across the fleet.
# The tracked .claude/settings.json and .claude/skills stay committed.
.claude/worktrees/

# Xcode derived data written by the documented iOS Simulator build recipe
/build/

# Old install-time fleet copy path. Fleet skills now seed from start.sh.
# Haus's own product skills live in the committed .agents/skills.
.cursor/skills
