{
  "name": "@haus/api",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "exports": {
    ".": "./src/index.ts",
    "./agent-activity": "./src/agent-activity.ts",
    "./app-protocol": "./src/app-protocol.ts",
    "./avatar": "./src/avatar.ts",
    "./avatar-generation": "./src/avatar-generation.ts",
    "./node/config": {
      "types": "./src/node/config.ts",
      "node": "./src/node/config.ts"
    },
    "./development-chat-demos": "./src/development-chat-demos.ts",
    "./computer-runtime": "./src/computer-runtime.ts",
    "./membership": "./src/membership.ts",
    "./participant-handle": "./src/participant-handle.ts",
    "./pane-links": "./src/runtime/pane-links.ts",
    "./rich-references": "./src/rich-references.ts",
    "./widgets": "./src/widgets/contracts.ts",
    "./widgets/artifact": "./src/widgets/artifact/contracts.ts",
    "./widgets/visual": "./src/widgets/visual/contracts.ts",
    "./openapi.yaml": "./openapi.yaml"
  },
  "scripts": {
    "build": "bun run generate",
    "check": "bun run generate:check && bun test",
    "generate": "openapi-typescript openapi.yaml -o src/generated/openapi.d.ts",
    "generate:check": "openapi-typescript openapi.yaml | diff -u src/generated/openapi.d.ts -",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "bun-types": "1.3.13",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "zod": "4.1.11"
  }
}
